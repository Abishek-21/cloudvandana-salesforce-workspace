# Salesforce OAuth settings for the backend.
SALESFORCE_LOGIN_URL=https://YOUR-DOMAIN.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Must match the callback registered in Salesforce.
SALESFORCE_CALLBACK_URL=http://localhost:8008/auth/callback
# Leave blank to use the org's latest supported API version.
SALESFORCE_API_VERSION=
