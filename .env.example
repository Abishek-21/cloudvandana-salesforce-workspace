# These are backend settings. Never put Salesforce secrets in frontend files.
SALESFORCE_LOGIN_URL=https://YOUR-DOMAIN.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_CALLBACK_URL=http://localhost:8008/auth/callback
# An optional supported REST version, such as 66.0. Blank discovers the org's latest.
SALESFORCE_API_VERSION=
